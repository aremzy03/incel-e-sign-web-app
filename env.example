########################################
# Core Django settings
########################################

# Django secret key (required in all environments)
SECRET_KEY=PunbWif0zYgZnWB-ibCjmNxw94RMh4WXecOSyxbQWRCUNcAMo-YQ34j2i6QbINaD5n9qESTx9C-pU8TESTlyJA

# Debug mode (True for local development, False in production)
DEBUG=True

# development | staging | production
# Derives AWS_LOCATION when AWS_LOCATION is unset. Staging MUST set this
# explicitly (DEBUG=False would otherwise default to production / incel-esign-app).
# Web and Celery workers on the same host must share the same ENVIRONMENT.
ENVIRONMENT=development

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=127.0.0.1,localhost


########################################
# Database configuration
########################################

# Example: local SQLite (Django will fall back to this if not provided)
# For PostgreSQL, use something like:
# postgresql://USER:PASSWORD@localhost:5432/incel_esign
DATABASE_URL=sqlite:///db.sqlite3

DB_NAME=esign_db
DB_USER=root
DB_PASSWORD=aremzyboss
DB_HOST=localhost
DB_PORT=5432

# Optional: PostgreSQL connection max age (seconds). Default 60 for shared DBs.
# DB_CONN_MAX_AGE=60

# Gunicorn worker count (default 3). Lower values reduce PostgreSQL connections.
# GUNICORN_WORKERS=3


########################################
# CORS / frontend integration
########################################

# Comma-separated list of allowed origins for the frontend app
# Example for React dev server:
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Base URL of the frontend application (used in emails/links)
FRONTEND_BASE_URL=http://localhost:3000


########################################
# REST framework pagination & throttling
########################################

# Default page size for paginated API responses
PAGE_SIZE=20

# Throttle rates (requests per window)
THROTTLE_RATE_ANON=100/hour
THROTTLE_RATE_USER=1000/hour
THROTTLE_RATE_AUTH=10/minute
THROTTLE_RATE_UPLOAD=20/hour


########################################
# File upload & media/static
########################################

# Max in-memory upload sizes (bytes)
FILE_UPLOAD_MAX_MEMORY_SIZE=26214400
DATA_UPLOAD_MAX_MEMORY_SIZE=26214400
DATA_UPLOAD_MAX_NUMBER_FIELDS=1000

# Static files
STATIC_URL=/static/
STATIC_ROOT=staticfiles

# Media files
MEDIA_URL=/media/
MEDIA_ROOT=media


########################################
# Email settings (development)
########################################

# In development you can use a real SMTP server or a local mail catcher
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=incelesign@gmail.com
EMAIL_HOST_PASSWORD=viyh ttyc fxei hngz
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=no-reply@incelgroup.com


########################################
# Celery (optional for development)
########################################

# Uncomment and configure if you want Celery running in dev
# Example using Redis on localhost:
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
# CELERY_WORKER_CONCURRENCY=2


########################################
# Cache / Redis (optional)
########################################

# To use Redis cache in dev, configure these; otherwise dummy cache is used.
# CACHE_BACKEND=django_redis.cache.RedisCache
# CACHE_LOCATION=redis://127.0.0.1:6379/1
# CACHE_TIMEOUT=300


########################################
# Sentry (optional)
########################################

# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=incel-esign-app@0.1.0


########################################
# AWS S3 storage (optional, typically for staging/production)
########################################

# USE_S3=False

# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_S3_REGION_NAME=us-east-1

# CloudFront CDN domain (hostname only, no https://). Do not add inline comments on the same line.
# AWS_S3_CUSTOM_DOMAIN=d1234abcdef.cloudfront.net

# CloudFront signed URLs — required for private S3 + direct browser PDF rendering.
# Create a key pair, add the public key to a CloudFront key group, and attach it to the distribution behavior.
# AWS_CLOUDFRONT_KEY_ID=APKAXXXXXXXXXXXXX
# Option A: PEM private key inline (use \n for line breaks)
# AWS_CLOUDFRONT_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"
# Option B: path to PEM file on the server (preferred in production)
# AWS_CLOUDFRONT_KEY_PATH=/etc/secrets/cloudfront-private-key.pem
# Signed URL lifetime in seconds (default 3600). Increase for long signing sessions.
# AWS_QUERYSTRING_EXPIRE=28800

# S3 key prefix inside the shared bucket. If unset, derived from ENVIRONMENT:
#   development → incel-esign-dev
#   staging     → incel-esign-staging
#   production  → incel-esign-app
# Non-production environments cannot use incel-esign-app (startup error).
# AWS_LOCATION=incel-esign-dev
# Optional: boto3 timeouts for Celery signing workers (seconds)
# AWS_S3_CONNECT_TIMEOUT=10
# AWS_S3_READ_TIMEOUT=60
# AWS_S3_MAX_ATTEMPTS=3


########################################
# Async signing pipeline
########################################

# ISO 8601 cutover timestamp; pending envelopes created before this are frozen at sign (409)
# SIGNING_CUTOVER_AT=2026-08-01T02:00:00+01:00
# MAX_MERGE_DOCUMENTS=10
# GUNICORN_TIMEOUT=120
# CELERY_WORKER_CONCURRENCY=4


########################################
# Misc / other settings
########################################

# Email backend for error reporting, logging, etc., uses EMAIL_* above.


########################################
# Google OAuth (for \"Continue with Google\")
########################################

# Google OAuth 2.0 client ID and secret for the Django backend
# Create credentials in Google Cloud Console (OAuth 2.0 Client ID, type: Web application)
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret

# Frontend route that handles the final login step after Django verifies Google
# This should correspond to a Next.js page like /auth/google/callback
GOOGLE_OAUTH_REDIRECT_PATH=/auth/google/callback


