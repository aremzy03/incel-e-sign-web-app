# Copy to .env and fill in real values. .env is gitignored.
# Access with {{process.env.VAR_NAME}} in request fields / scripts.

# UI / password login (Auth/Login.bru)
LOGIN_EMAIL=
LOGIN_PASSWORD=

# First-party integration credentials (Django admin → Integrations)
ESIGN_CLIENT_ID=
ESIGN_CLIENT_SECRET=

# User asserted on token exchange (must exist, or JIT must be on)
PARTNER_USER_EMAIL=
PARTNER_USER_FULL_NAME="Your Full Name"

# Optional: stable partner user id → IntegrationUserLink upsert
PARTNER_EXTERNAL_USER_ID=

# Existing e-sign user UUID used as signer in Partner Flow create
SIGNER_USER_ID=
