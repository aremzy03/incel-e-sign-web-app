meta {
  name: Token Exchange Bad Secret
  type: http
  seq: 2
  tags: [
    integrations
    negative
  ]
}

post {
  url: {{baseUrl}}/api/v1/integrations/token/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "client_id": "{{process.env.ESIGN_CLIENT_ID}}",
    "client_secret": "definitely-not-the-real-secret",
    "email": "{{process.env.PARTNER_USER_EMAIL}}",
    "full_name": "{{process.env.PARTNER_USER_FULL_NAME}}"
  }
}

vars:pre-request {
  baseUrl: http://localhost:8000
}

assert {
  res.status: eq 401
  res.body.status: eq error
}
