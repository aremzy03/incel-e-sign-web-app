meta {
  name: 03 Create Envelope
  type: http
  seq: 3
  tags: [
    partner-flow
    smoke
  ]
}

post {
  url: {{baseUrl}}/api/envelopes/create/
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "name": "Bruno Partner Flow Envelope",
    "document_ids": ["{{documentId}}"],
    "signing_order": [
      {
        "signer_id": "{{process.env.SIGNER_USER_ID}}",
        "order": 1
      }
    ]
  }
}

script:post-response {
  if (res.status === 201 && res.body && res.body.data && res.body.data.id) {
    bru.setVar("envelopeId", res.body.data.id);
    bru.setEnvVar("envelopeId", res.body.data.id);
  }
}

assert {
  res.status: eq 201
  res.body.status: eq success
  res.body.data.id: isDefined
}
